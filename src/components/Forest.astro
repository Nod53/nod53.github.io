---
// Procedural forest silhouette. Seeded so every build looks identical.
function rng(seed: number) {
  return () => {
    seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const W = 1440, H = 260;
function layer(seed: number, count: number, minH: number, maxH: number) {
  const r = rng(seed);
  let d = '';
  for (let i = 0; i < count; i++) {
    const x = (i + r() * 0.8) * (W / count);
    const h = minH + r() * (maxH - minH);
    const w = h * (0.28 + r() * 0.12);
    const tiers = 5;
    const top = H - h;
    let right = '', left = '';
    for (let t = 0; t < tiers; t++) {
      const y = top + (h * (t + 1)) / tiers;
      const hw = (w / 2) * ((t + 1) / tiers);
      right += ` L${(x + hw).toFixed(1)},${y.toFixed(1)} L${(x + hw * 0.5).toFixed(1)},${y.toFixed(1)}`;
      left = ` L${(x - hw * 0.5).toFixed(1)},${y.toFixed(1)} L${(x - hw).toFixed(1)},${y.toFixed(1)}` + left;
    }
    d += `M${x.toFixed(1)},${top.toFixed(1)}${right} L${x + 4},${H} L${x - 4},${H}${left} Z `;
  }
  return d + `M0,${H} L${W},${H} L${W},${H - 6} L0,${H - 6} Z`;
}
const far = layer(7, 46, 90, 190);
const mid = layer(21, 34, 120, 235);
const near = layer(63, 22, 150, 260);
---
<svg class="forest" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
  <path d={far} fill="#0d2417" />
  <path d={mid} fill="#09180f" />
  <path d={near} fill="#060d09" />
</svg>
